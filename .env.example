# Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# CricketData.org API key (cricketdata.org -> signup -> Member Area)
# Free tier: 100 requests/day, no expiry, covers Test/ODI/T20 matches
CRICKETDATA_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Slack Incoming Webhook URL (api.slack.com/apps -> your app -> Incoming Webhooks)
# Optional -- leave blank to skip Slack delivery
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# How often to poll for match updates, in minutes.
# CricketData free tier = 100 req/day, so don't go below ~10-15 min if tracking
# multiple matches, or you'll burn through the daily quota.
POLL_INTERVAL_MINUTES=15

# Port the dashboard server listens on
PORT=3000
