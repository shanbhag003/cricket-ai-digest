# Anthropic API key -- console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Which model. claude-sonnet-5 ($2/$10 per Mtok) is the default.
# claude-haiku-4-5-20251001 ($1/$5) is plenty for this task and half the price.
CLAUDE_MODEL=claude-sonnet-5

# Comma-separated terms matched against BOTH the ESPN series name and the
# event name, e.g. "India,Sri Lanka". Blank = first live cricket match found.
TEAM_FILTER=India,Sri Lanka

# Slack Incoming Webhook. Optional -- blank skips Slack delivery.
SLACK_WEBHOOK_URL=

# How often to hit ESPN's cheap 6 KB scoreboard endpoint. SECONDS.
POLL_INTERVAL_SECONDS=60

# Hard floor between Claude calls for the same match. SECONDS.
# Stops a 3-wickets-in-2-overs collapse becoming 3 API calls in 90 seconds.
MIN_SECONDS_BETWEEN_DIGESTS=120

PORT=3000
