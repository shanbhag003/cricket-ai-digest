# ---- required ----------------------------------------------------------
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx


# ---- optional (sensible defaults if omitted) ---------------------------

# Which Claude model. claude-sonnet-5 ($2/$10 per Mtok) is the default.
# claude-haiku-4-5-20251001 ($1/$5) is plenty for this task and half the price.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Output ceiling per digest call. 400 was too low and produced truncated JSON —
# if you still see "reply was cut off", raise this. Thinking tokens (if the
# model emits them) count against the same budget. You only pay for tokens
# actually generated, so headroom is free.
CLAUDE_MAX_TOKENS=4096

# Extended thinking shares the max_tokens budget with the visible reply, and on
# Sonnet 5 it can consume the WHOLE budget — returning stop_reason=max_tokens
# with no text at all. This task needs no deliberation, so thinking is off.
# Set to "default" only if you want the model's own default behaviour back.
CLAUDE_THINKING=disabled

# How many deliveries of ball-by-ball commentary to send with each digest.
# ESPN has no structured shot/length tags, but the commentary prose describes
# them ("dug in short", "scythes it past sweeper cover"). ~50 tokens each.
# 0 disables it. Fetched only when a digest is written, not on every poll.
BALL_BY_BALL_COUNT=6

# Startup default only. Matched against BOTH the ESPN series name and the
# event name. The dashboard dropdown overrides this at runtime.
# Blank = first live cricket match found anywhere.
TEAM_FILTER=India,Sri Lanka

# How often to hit ESPN's cheap ~6 KB scoreboard endpoint. SECONDS.
POLL_INTERVAL_SECONDS=30

PORT=3000


# ---- leave these alone unless you have a reason ------------------------

# Overrides the PER-FORMAT digest floor. Leave UNSET so each format uses its
# own: Test 180s, ODI/List A 120s, T20 90s. Setting it applies one value to
# every format, which is worse.
# MIN_SECONDS_BETWEEN_DIGESTS=

# Set "true" to emit a digest immediately on every restart. Default false.
# Leave false — otherwise every crash, redeploy and spin-down wake produces a
# digest for a match state that hasn't actually moved.
# DIGEST_ON_STARTUP=false

# Where restart-safe state is cached. Render's free filesystem is ephemeral,
# so this survives crash loops but not redeploys.
# STATE_FILE=/tmp/cricket-digest-state.json
